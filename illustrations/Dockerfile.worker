# Winsome modify worker — stateless gpt-image-1 EDIT + rembg cutout service.
# Build context = this illustrations/ directory:
#   docker build -f Dockerfile.worker -t winsome-worker .
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY make.py registry.py worker.py ./

# Bake the rembg model so the first modify isn't slow.
RUN python -c "from rembg import new_session; new_session('u2net')"

ENV PORT=8080
EXPOSE 8080
CMD ["python", "worker.py"]
