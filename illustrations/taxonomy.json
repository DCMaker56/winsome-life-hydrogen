{
  "$comment": "The Winsome Life illustration library plan. The generation runner expands every (niche → subject) × (style) into one illustration named {niche}/{subjectSlug}-{styleKey}. Prompts are FIXED; only [SUBJECT] changes. Keep this file as the single source of truth.",
  "version": 1,
  "styles": [
    {
      "key": "watercolor",
      "name": "Watercolor",
      "feel": "Soft, artistic, classic",
      "prompt": "Create a hand-painted watercolor illustration of a [SUBJECT]. Use soft watercolor washes with subtle pigment variation and visible watercolor texture. Colors should be natural and slightly muted rather than overly saturated. Include gentle shading and realistic proportions with crisp but painterly edges. Avoid heavy outlines, cartoon styling, or clipart appearance. The illustration should feel elegant, timeless, and suitable for luxury personalized stationery. Isolate the artwork on a pure white background with no shadows or additional elements."
    },
    {
      "key": "heritage-sketch",
      "name": "Heritage Sketch",
      "feel": "Timeless, sophisticated, heirloom-quality",
      "prompt": "Create a highly detailed black-and-white pen-and-ink illustration of a [SUBJECT]. Use fine crosshatching, stippling, engraved line work, and intricate texture to create depth and realism. The illustration should resemble a vintage natural history engraving or 19th-century scientific field guide illustration. No color. No grayscale shading. White background only. The artwork should feel refined, timeless, and suitable for luxury stationery."
    },
    {
      "key": "modern-graphic",
      "name": "Modern Graphic",
      "feel": "Clean, fresh, contemporary",
      "prompt": "Create a clean modern digital illustration of a [SUBJECT] using simplified geometric shapes, flat colors, subtle texture, and minimal shading. Maintain realistic proportions while using a contemporary vector-inspired aesthetic. Avoid heavy outlines, clipart appearance, cartoon exaggeration, or photorealism. Colors should be sophisticated and harmonious with a premium lifestyle brand. Isolate on a white background."
    }
  ],
